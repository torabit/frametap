# frametap の設定。実行ファイルと同じディレクトリに frametap.toml として置く。
# 置かなくても既定値で動く。書いた値が受け付けられなければ、画面の上に警告が出る。

# F 換算の基準。対象のゲームのフレームレートに合わせる。
fps = 60

# 試行を区切る無入力時間 (ms)。全部離してこの時間が過ぎたら、次の入力は別の試行になる。
trial_gap_ms = 300

# 左スティックを方向入力と見なす閾値。中心からの正規化距離で、0 から 1 の間。
stick_deadzone = 0.5

# 画面に積む試行の数。
trials_shown = 5
